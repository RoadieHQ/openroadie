{
  "name": "@roadiehq/ai-backend",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "roadie": {
    "role": "backend-plugin",
    "pluginId": "ai-backend",
    "pluginPackages": [
      "@roadiehq/ai-backend"
    ]
  },
  "scripts": {
    "start": "roadie-cli package start",
    "build": "roadie-cli package build",
    "lint": "roadie-cli package lint",
    "test": "vitest run",
    "test:ci": "vitest run --passWithNoTests --coverage",
    "clean": "roadie-cli package clean",
    "prepack": "roadie-cli package prepack",
    "postpack": "roadie-cli package postpack"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/mcp": "^2.0.83",
    "@ai-sdk/openai": "^4.0.101",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@roadiehq/ai-node": "workspace:^",
    "@roadiehq/config": "workspace:^",
    "@roadiehq/extensions-api": "workspace:^",
    "@roadiehq/scopes": "workspace:^",
    "ai": "^7.0.150",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "lodash": "^4.17.21",
    "uuid": "^14.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "*",
    "@types/lodash": "^4.17.27",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ]
