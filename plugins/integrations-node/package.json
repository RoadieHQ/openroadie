{
  "name": "@roadiehq/integrations-node",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "roadie": {
    "role": "node-library"
  },
  "scripts": {
    "start": "roadie-cli package start",
    "build": "roadie-cli package build",
    "lint": "roadie-cli package lint",
    "test": "vitest run",
    "test:ci": "vitest run --passWithNoTests --coverage",
    "clean": "roadie-cli package clean",
    "prepack": "roadie-cli package prepack",
    "postpack": "roadie-cli package postpack"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudcontrol": "^3.1146.0",
    "@aws-sdk/credential-providers": "^3.1146.0",
    "@roadiehq/errors": "workspace:^",
    "@roadiehq/extensions-api": "workspace:^",
    "@roadiehq/jsonata-safe": "workspace:^",
    "@roadiehq/secrets-node": "workspace:^",
    "@roadiehq/types": "workspace:^",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "fast-xml-parser": "^5.7.1",
    "graphql": "^15.5.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.0.0",
    "undici": "^7.29.0",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/jsonwebtoken": "^9",
    "@types/luxon": "^3",
    "vitest": "^4.1.11"
  }
}
