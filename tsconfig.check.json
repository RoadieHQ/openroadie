{
  "extends": "./tsconfig.json",
  "include": [
    "globals.d.ts",
    "packages/*/src",
    "plugins/*/src",
    "plugins/*/dev",
    "plugins/*/migrations",
    "internal/*/src"
  ],
  "exclude": ["packages/app/src"],
  "compilerOptions": {
    "outDir": "dist-types",
    "rootDir": ".",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "types": ["vitest/globals", "node"]
  }
}
