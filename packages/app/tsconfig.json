{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist-types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["vitest/globals"],
    "paths": {
      "~auth": ["./src/auth-noop.ts"],
      "~admin-section-extensions": [
        "./src/config/admin-section-extensions-noop.ts"
      ],
      "~app-config": ["./src/api/infrastructure/stubs/app-config.bundle.ts"]
    }
  },
  "include": ["src"]
}
