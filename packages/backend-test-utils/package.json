  "description": "Test helpers library for Roadie backends",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "roadie": {
    "role": "node-library"
  },
  "scripts": {
    "build": "roadie-cli package build",
    "clean": "roadie-cli package clean",
    "lint": "roadie-cli package lint",
