# OpenRoadie environment. `openroadie init` generates this file with a random
# auth secret. Edit DATABASE_URL to point at your Postgres instance.

# Postgres connection string (required).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openroadie

# Backend auth signing secret. Any sufficiently long random string.
OPENROADIE_AUTH_SECRET=change-me

# Optional integration tokens — uncomment and fill in as needed.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# AI_PROVIDER_ANTHROPIC_API_KEY=
