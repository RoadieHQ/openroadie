    "@roadiehq/integrations-backend": "workspace:^",
    "@roadiehq/mcp-actions-module": "workspace:^",
    "@roadiehq/mcp-catalog-datastore-module": "workspace:^",
    "@roadiehq/mcp-settings-backend": "workspace:^",
    "@roadiehq/roadie-mcp-server": "workspace:^",
    "@roadiehq/secrets-settings-backend": "workspace:^",
    "@roadiehq/workspaces-backend": "workspace:^",
    "express": "^4.17.1",
    "knex": "^2.4.0",
    "pg-format": "^1.0.4"
