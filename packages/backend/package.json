  "main": "dist/index.cjs.js",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "roadie": {
    "role": "backend"
  },
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
